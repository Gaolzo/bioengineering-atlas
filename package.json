{
  "name": "bioengineering-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test tests/scholar-import.node.mjs",
    "test:e2e": "playwright test",
    "scholar:import": "node scripts/import-scholar.mjs",
    "bibliography:audit": "node scripts/audit-bibliography.mjs"
  },
  "dependencies": {
    "i18next": "^26.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
